APP_ENV=local
SSL_MODE=false

# API Ports
API_PORT=8080
WEB_PORT=3000

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Spring Configuration
SPRING_PROFILES_ACTIVE=local
INTEGRATIONS_MODE=mock

# Security
JWT_SECRET=titanium_booking_secure_key_32_chars_at_least
JWT_EXPIRY_SECONDS=7200
JWT_REFRESH_EXPIRY_SECONDS=1209600
WEBHOOK_SECRET=change_me

# External Services
PAYMENT_REAL_API_KEY=
EMAIL_REAL_API_KEY=
SMS_REAL_API_KEY=

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Web Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

