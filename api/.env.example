# --- BACKEND DOMAIN MASTER ---
API_PORT=5080
APP_ENV=local
SPRING_PROFILES_ACTIVE=local
SSL_MODE=disable

# Database (Local access)
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=booking_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# Legacy Docker compatibility mappings (Fallback)
POSTGRES_HOST=${DB_HOST}
POSTGRES_PORT=${DB_PORT}

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
JWT_SECRET=titanium_booking_secure_key_32_chars_at_least
JWT_EXPIRY_SECONDS=7200
JWT_REFRESH_EXPIRY_SECONDS=1209600
WEBHOOK_SECRET=change_me

# Logic / Integrations
INTEGRATIONS_MODE=mock
CORS_ALLOWED_ORIGIN=http://localhost:3080
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
